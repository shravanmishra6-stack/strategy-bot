# ============================================================================
# Copy to `.env` (gitignored) and fill in. NEVER put these in the dashboard.
# ============================================================================

# --- Safety switch ----------------------------------------------------------
# true  -> bot computes signals and simulates fills locally. Zero orders sent.
# false -> REAL money orders go to Shoonya. Only flip after paper sessions.
PAPER_MODE=true

# Kill switch: any of true/1/yes stops new entries AND squares off open legs.
KILL_SWITCH=false

# --- Shoonya OAuth credentials ---------------------------------------------
# From Shoonya web -> API button -> API Key. Two-phase token flow:
#   python -m scripts.oauth_login                 # prints the authorize URL
#   (log into Shoonya in that browser, open the URL, copy code= from the redirect)
#   python -m scripts.oauth_login --authcode XXX  # exchanges + writes the keys below
SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=
SHOONYA_UID=
SHOONYA_ACCOUNT_ID=
SHOONYA_ACCESS_TOKEN=
# Browser authorize page (NOT the API host). Verified against Shoonya's own
# /OAuthlogin/ SPA: route '/authorize/oauth' reads client_id from the query.
# The old 'NorenWeb/authorize/oauth' path returns 404.
SHOONYA_OAUTH_URL=https://api.shoonya.com/OAuthlogin/authorize/oauth
# Written by phase 2 as well; kept here so the file is complete.
SHOONYA_REFRESH_TOKEN=

# UAT vs live hosts. Leave defaults until you have a working UAT session.
SHOONYA_HOST=https://api.shoonya.com/NorenWClientAPI/
SHOONYA_WEBSOCKET=wss://api.shoonya.com/NorenWSAPI/

# --- Broker instrument identities -------------------------------------------
# Defaults are the values CONFIRMED against this account on the live API, and
# only need changing if the broker moves them. Verified 2026-09-27:
#   * NFO is the F&O segment this account can trade. 'NSE_FNO' is rejected with
#     HTTP 404 "No Data : Exchange Not enabled", so do not set it.
#   * The NIFTY spot index quotes on exchange NSE under token 26000 ("Nifty 50").
#     The legacy token 13 returns no data.
#   * Weekly NIFTY contracts expire on Tuesdays (29-SEP/06-OCT/13-OCT 2026).
SHOONYA_FNO_EXCHANGE=NFO
SHOONYA_INDEX_EXCHANGE=NSE
SHOONYA_INDEX_TOKEN=26000
SHOONYA_ROOT_SYMBOL=NIFTY
SHOONYA_EXPIRY_WEEKDAYS=1
# Shoonya product code for intraday option orders (C=delivery, I=intraday,
# M=normal/MIS). "MIS" is NOT a valid Shoonya code.
SHOONYA_PRODUCT_TYPE=M

# --- Historical data (your existing Breeze CSV dump, reused for backtests) --
DATA_DIR=C:\Users\sharv\Desktop\nifty_breeze_data

# --- Risk limits ------------------------------------------------------------
RISK_MAX_DAILY_LOSS_PTS=400
RISK_MAX_LOTS=2
RISK_MAX_ENTRIES_PER_DAY=2
RISK_NO_NEW_ENTRY_AFTER=14:45

# --- Server -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
